--- a/engine/game/scripts/maps/mp/gametypes/_damage.gsc
+++ b/engine/game/scripts/maps/mp/gametypes/_damage.gsc
@@ -1541,7 +1541,13 @@
 
 		if ( isDefined( damager) && damager != victim && iDamage > 0 )
 		{
-			if ( iDFlags & level.iDFLAGS_STUN )
+			// finishPlayerDamageWrapper has already applied this damage, so a
+			// victim that is no longer alive (a faux death counts as dead) was
+			// killed by this hit. Kill wins over the armour and endgame art:
+			// a lethal hit must leave the red kill marker, never the hit one.
+			if ( !isReallyAlive( victim ) )
+				typeHit = "kill";
+			else if ( iDFlags & level.iDFLAGS_STUN )
 				typeHit = "stun";
 			else if ( victim hasPerk( "specialty_armorvest", true ) || (isExplosiveDamage( sMeansOfDeath ) && victim _hasPerk( "_specialty_blastshield" )) )
 				typeHit = "hitBodyArmor";
