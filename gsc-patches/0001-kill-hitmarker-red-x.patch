@@ -44,7 +45,16 @@
 	feedbackDurationOverride = 0;
 	startAlpha = 1;
 	
-	if ( typeHit == "hitBodyArmor" )
+	// A lethal hit swaps the marker to the red kill_feedback art. The caller
+	// passes "kill" only when this damage killed the victim, so the same
+	// element still shows damage_feedback for every non-lethal hit. The hit
+	// sound is deliberately unchanged here; only the marker art is.
+	if ( typeHit == "kill" )
+	{
+		self.hud_damagefeedback setShader("kill_feedback", 24, 48);
+		self playlocalsound("MP_hit_alert");
+	}
+	else if ( typeHit == "hitBodyArmor" )
 	{
 		self.hud_damagefeedback setShader("damage_feedback_j", 24, 48);
